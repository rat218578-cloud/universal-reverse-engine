{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Reverse Engine",
  "version": "1.0.0",
  "identifier": "dev.ure.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Análise de APK e EXE/DLL",
    "longDescription": "Universal Reverse Engine: análise estática de APK, PE, .NET e bibliotecas nativas, executada localmente.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/ure": "backend/ure",
      "../../web": "backend/ure/web"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
