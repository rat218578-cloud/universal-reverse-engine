# Copie para ure.env e ajuste. Só chaves URE_* são lidas.
# Variáveis já definidas no ambiente têm precedência sobre este arquivo.
# Não coloque segredos reais em arquivos versionados.

# Endereço e porta (mantenha 127.0.0.1 salvo se souber o que está fazendo)
URE_HOST=127.0.0.1
URE_PORT=8765

# Diretório de dados (banco, artefatos, token de sessão). Padrão: ./data
URE_DATA_DIR=./data

# Limites
URE_MAX_UPLOAD_MB=512
URE_MAX_EXTRACT_MB=2048
URE_JOB_TIMEOUT_S=900
URE_SOCKET_TIMEOUT_S=30

# Ferramentas externas. O servidor lê /opt/ure-tools/tools.env (gerado por scripts/install-tools.sh)
# automaticamente; URE_TOOLS_ENV aponta para outro arquivo. Variáveis definidas aqui têm precedência.
# URE_TOOLS_ENV=/opt/ure-tools/tools.env
# Sem isso, o URE procura no PATH.
# URE_APKTOOL=/caminho/para/apktool
# URE_JADX=/caminho/para/jadx
# URE_APKANALYZER=/caminho/para/apkanalyzer
# URE_ILSPYCMD=/caminho/para/ilspycmd
# URE_GHIDRA=/caminho/para/analyzeHeadless

# Hosts adicionais aceitos no cabeçalho Host (ex.: nome de contêiner)
# URE_ALLOWED_HOSTS=meu-host.local:8765

# IA opcional, desligada por padrão. Exige Ollama local ou consentimento por requisição.
URE_AI_ENABLED=0
# URE_OLLAMA_MODEL=llama3.2
# URE_EXTERNAL_AI_URL=https://provedor.exemplo/v1/chat/completions
# A chave do provedor externo deve ser definida no ambiente, não neste arquivo:
# export URE_EXTERNAL_AI_KEY=...
